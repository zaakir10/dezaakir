# ──────────────────────────────────────────────────────────────
# Dezaakir Frontend (Next.js / React / Tailwind) — .gitignore
# ──────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js Build Outputs
.next/
out/
dist/
build/
.turbo/
.vercel/

# TypeScript Build Info & Generated Declarations
*.tsbuildinfo
next-env.d.ts

# Environment configuration — NEVER commit secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
test-results/
playwright-report/

# Temporary files & caches
.cache/
.tmp/
temp/

# OS and Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
