# ──────────────────────────────────────────────────────────────
# Dezaakir Frontend — Environment Template
# Copy this file to `frontend/.env.local` or `frontend/.env`.
# All values prefixed with NEXT_PUBLIC_ are bundled into client code.
# NEVER place private secrets (database, SMTP, signing keys) here.
# ──────────────────────────────────────────────────────────────

# Public base URL of the Next.js portfolio website
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL of the Dezaakir Express API
NEXT_PUBLIC_API_URL=http://localhost:4000
