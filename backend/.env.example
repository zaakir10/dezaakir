

NODE_ENV=development
PORT=4000
# Public origin of the Next.js frontend (used for CORS, CSRF origin checks and email links)
FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of the API (0 locally, usually 1 in production)
TRUST_PROXY=0
LOG_LEVEL=info

# ── MongoDB Atlas (use separate databases for dev and production) ──
MONGODB_URI=mongodb+srv://dezaakir:hy5s6546j9pqN2Wg@cluster0.zm8wzfe.mongodb.net/

# ── Secrets — see docs/DEPLOYMENT.md "Generate secrets" for one-line generators ──
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_HMAC_SECRET=replace-with-at-least-32-random-characters
# Encrypts admin TOTP secrets at rest (32 bytes, base64)
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ── Gmail SMTP (use a Gmail App Password — NEVER your normal Gmail password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=ityqplikegbuhqda
EMAIL_FROM="zaakirpro1@gmail.com>"

# ── Cloudinary (signed uploads only) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
