# ──────────────────────────────────────────────────────────────
# Dezaakir Backend (Bun / Express / Mongoose) — .gitignore
# ──────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js
.bun-tmp/

# Build & Compilation Outputs
dist/
build/
*.tsbuildinfo

# Environment configuration & secrets — NEVER commit
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
.env.example

# Secrets, Encryption Keys, Certificates & Recovery Codes
*.pem
*.key
*.cert
*.crt
recovery-codes*.txt

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
pnpm-debug.log*

# Database Backups & Dumps (never commit local data dumps)
backups/
*.archive
*.bson
*.dump

# Uploads & Temporary Storage
uploads/
temp/
.tmp/
.cache/

# Testing & Coverage Reports
coverage/
.nyc_output/
test-results/

# OS and Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
